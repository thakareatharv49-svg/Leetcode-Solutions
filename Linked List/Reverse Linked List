
class Solution {
    public ListNode reverseList(ListNode head) {
       ListNode prev = null;
       ListNode current = head;
      ListNode next = null;

        while (current != null) {

            // Store next node
            next = current.next;

            // Reverse the link
            current.next = prev;

            // Move prev and current one step ahead
            prev = current;
            current = next;
        }

        return prev;
    }
}
