class Solution {
    public List<Integer> findMissingElements(int[] nums) {
        Arrays.sort(nums);
        ArrayList<Integer> list = new ArrayList<>();
        
        for(int i =0;i < nums.length-1;i++) {
            if(nums[i+1] != nums[i] +1) {
                int missing = nums[i] +1;
                while(missing < nums[i +1]) {
                    list.add(nums[i] +1);
                    missing++;
                }
            }
        }

        return list;
    }
}
