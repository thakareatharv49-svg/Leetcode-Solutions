import java.util.Arrays;

class Solution {
    public int missingNumber(int[] nums) {

        Arrays.sort(nums);

        // Check if 0 is missing
        if (nums[0] != 0) {
            return 0;
        }

        // Check for a gap
        for (int i = 0; i < nums.length - 1; i++) {
            if (nums[i] + 1 != nums[i + 1]) {
                return nums[i] + 1;
            }
        }

        // If no gap, n is missing
        return nums.length;
    }
}
