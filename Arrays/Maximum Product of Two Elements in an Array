import java.util.Arrays;

class Solution {
    public int maxProduct(int[] nums) {

        // Step 1: Sort the array
        Arrays.sort(nums);

        // Step 2: Take the two largest elements
        int i = nums.length - 1;
        int j = nums.length - 2;

        // Step 3: Return the required product
        return (nums[i] - 1) * (nums[j] - 1);
    }
}
