class Solution {
    public boolean isMonotonic(int[] nums) {

        int i = 0;
        int j = 1;

        boolean increasing = true;
        boolean decreasing = true;

        while (j < nums.length) {

            if (nums[i] > nums[j]) {
                increasing = false;
            }

            if (nums[i] < nums[j]) {
                decreasing = false;
            }

            i++;
            j++;
        }

        return increasing || decreasing;
    }
}
