class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {

        int n = nums1.length;
        int m = nums2.length;

        int[] arr = new int[n + m];

        // Copy nums1
        for (int i = 0; i < n; i++) {
            arr[i] = nums1[i];
        }

        // Copy nums2
        for (int i = 0; i < m; i++) {
            arr[n + i] = nums2[i];
        }

        // Sort the merged array
        Arrays.sort(arr);

        int size = arr.length;

        // Odd number of elements
        if (size % 2 == 1) {
            return arr[size / 2];
        }

        // Even number of elements
        return (arr[size / 2] + arr[(size / 2) - 1]) / 2.0;
    }
}
