import java.util.Arrays;

class Solution {
    public int[] sortedSquares(int[] nums) {

        // Step 1: Square every element
        for (int i = 0; i < nums.length; i++) {
            nums[i] = nums[i] * nums[i];
        }

        // Step 2: Sort the squared array
        Arrays.sort(nums);

        return nums;
    }
}
